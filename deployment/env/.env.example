# ==============================================================================
# VoiceShield Production Environment Configuration Template
# Copy to .env and adjust sensitive credentials and operational boundaries.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Logging & Observability
LOG_LEVEL=INFO
METRICS_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true

# Security & CORS
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=https://voiceshield.internal,https://app.voiceshield.com

# Model Filepaths and Cryptographic SHA-256 Checksums
AASIST_MODEL_PATH=models/weights/AASIST.pth
AASIST_MODEL_SHA256=51d2d9cf887cf51c4a04d9e5f4bb5d9e50beec7908b9f1d04ba4e326c5ea1f2d

ECAPA_MODEL_PATH=models/weights/embedding_model.ckpt
ECAPA_MODEL_SHA256=0575cb64e222e379435b867c4ec2353ecfb32fb6d0d216d2fdb6f62b87e224e7

# Enforce strict startup checksum verification (fails startup if SHA-256 mismatches)
STRICT_MODEL_INTEGRITY_CHECK=true

# Streaming Pipeline Capacity & Safeguards
MAX_ACTIVE_SESSIONS=20
MAX_STREAM_CHUNK_BYTES=65536
MAX_STREAM_MESSAGE_BYTES=131072
STREAM_RATE_LIMIT_CHUNKS_PER_SEC=20
SESSION_IDLE_TTL_SEC=300
